{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Just Notes",
  "version": "0.1.0",
  "identifier": "dev.just-notes",
  "build": {
    "beforeDevCommand": "bun dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Just Notes",
        "width": 1120,
        "height": 720,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.4",
      "entitlements": "./Entitlements.plist",
      "signingIdentity": "Apple Development: zhuocheng.yu.d@gmail.com (8N9LZ4A85R)"
    }
  }
}
