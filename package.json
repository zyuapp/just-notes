{
  "name": "just-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "legal:notices": "bun scripts/generate-third-party-notices.ts",
    "legal:notices:check": "scripts/check-legal-notices-clean.sh",
    "bindings:rs": "cd src-tauri && cargo test --locked export_bindings",
    "bindings:rs:check": "scripts/check-bindings-clean.sh",
    "deps:sherpa:check": "bun scripts/check-sherpa-resolution.ts",
    "test:fe": "bun test ./src",
    "lint:fe:boundary": "scripts/check-frontend-api-boundary.sh",
    "lint:fe:components": "scripts/check-frontend-component-boundary.sh",
    "lint:fe:files": "scripts/check-frontend-file-lines.sh",
    "fmt:rs": "cd src-tauri && cargo fmt -- --check",
    "lint:rs": "cd src-tauri && cargo clippy --locked --all-targets --all-features -- -D warnings -W clippy::cognitive-complexity -W clippy::too-many-lines",
    "lint:rs:domains": "scripts/check-rust-domain-boundaries.sh",
    "lint:rs:files": "scripts/check-rust-file-lines.sh",
    "test:rs": "cd src-tauri && cargo test --locked --all-features",
    "test:quality": "cd src-tauri && cargo test --locked --release --all-features quality_ -- --ignored --nocapture",
    "test:quality:setup": "scripts/setup-quality-fixtures.sh",
    "verify": "bun run bindings:rs:check && bun run legal:notices:check && bun run deps:sherpa:check && bun run build && bun run lint:fe:boundary && bun run lint:fe:components && bun run lint:fe:files && bun run test:fe && bun run fmt:rs && bun run lint:rs && bun run lint:rs:domains && bun run lint:rs:files && bun run test:rs",
    "tauri": "tauri",
    "app:build": "scripts/build-app.sh",
    "app:release": "JUST_NOTES_RELEASE=1 scripts/build-app.sh",
    "app:install": "bun run app:build && scripts/install-app.sh",
    "app:release:install": "bun run app:release && scripts/install-app.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "happy-dom": "20.11.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.5"
  },
  "overrides": {
    "postcss": "8.5.23"
  }
}
